# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string — get this from your Neon dashboard (or any PG provider).
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── App URL (used in email links) ───────────────────────────────────────────
# Set to your production domain when deploying (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -base64 48)
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# ─── Gmail SMTP (email notifications) ────────────────────────────────────────
# How to get GMAIL_APP_PASSWORD:
#   1. Enable 2-Step Verification on your Google Account
#   2. Go to Google Account → Security → App Passwords
#   3. Generate a new App Password for "Mail" / "Other (custom name)"
#   4. Copy the 16-character password (spaces are fine, nodemailer strips them)
#
# Note: Gmail limits ~500 emails/day on personal accounts.
# For higher volume switch to a transactional provider (Resend, SendGrid, SES).

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=Haveniq

# ─── Google OAuth (Google Calendar / Meet scheduling) ────────────────────────
# How to get these:
#   1. Go to https://console.cloud.google.com → New project
#   2. Enable "Google Calendar API" in APIs & Services → Library
#   3. APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
#   4. Set Authorised redirect URIs to: http://localhost:3000/api/auth/google/callback
#   5. Copy Client ID and Client Secret below
#
# GOOGLE_REDIRECT_URI defaults to http://localhost:3000/api/auth/google/callback if not set.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── AI / external services ───────────────────────────────────────────────────
# (Add other keys here as needed, e.g. ANTHROPIC_API_KEY, LIVEKIT_*, etc.)
