{
  "name": "realestate-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:ledger": "npx tsx lib/__tests__/ledger.test.ts",
    "test:attributes": "npx tsx lib/__tests__/attributes.test.ts",
    "seed:neon": "npx tsx scripts/seed-neon.ts",
    "make-admin": "node scripts/make-admin.mjs",
    "build:building": "npx tsx scripts/building/pipeline.ts",
    "worker": "npx tsx scripts/twin/build-worker.ts --preview",
    "worker:full": "npx tsx scripts/twin/build-worker.ts",
    "studio:test": "vitest run lib/__tests__/studio",
    "studio:publish": "tsx scripts/studio/ingest/publish.mts",
    "studio:open": "node scripts/studio/open-studio.mjs",
    "studio:e2e": "node scripts/studio/e2e-design.mjs && node scripts/studio/e2e-plan.mjs && node scripts/studio/e2e-generated.mjs && node scripts/studio/e2e-arch.mjs",
    "studio:still": "node scripts/studio/still.mjs --wait=90",
    "studio:e2e:still": "node scripts/studio/e2e-still.mjs",
    "studio:e2e:mobile": "node scripts/studio/e2e-mobile.mjs --lang=en && node scripts/studio/e2e-mobile.mjs --lang=he",
    "studio:a11y": "node scripts/studio/a11y.mjs",
    "studio:vr": "node scripts/studio/visual-regression.mjs",
    "studio:bench": "node scripts/studio/bench.mjs http://localhost:3001 --studio --furnish --uncapped=1 --hp=1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@hyzyla/pdfium": "^3.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/nodemailer": "^8.0.1",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "googleapis": "^176.0.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "^2.20.2",
    "next": "16.2.11",
    "nodemailer": "^9.0.5",
    "pannellum-react": "^1.2.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "postprocessing": "^6.39.5",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.18",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
