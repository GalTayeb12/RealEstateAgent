# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# local databases
dev.db
*.db
*.sqlite
*.sqlite3

# log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
*.log

# env files
.env
.env.local
.env.*.local
# Keep .env.example tracked (must contain placeholders only)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/app/generated/prisma

# Claude Code — local settings and temporary worktrees
.claude/settings.local.json
.claude/worktrees/

# IDE / editor local files
.windsurf/
.vscode/settings.json
.idea/

# Portable Blender — install locally, do not version
/scripts/building/blender/
/scripts/building/*.zip

# Offline bake inputs and intermediates
/scripts/building/output/
/scripts/building/assets/*.hdr
/scripts/building/assets/*.exr

# Blender sources and Python caches
*.blend
*.blend1
*.blend2
__pycache__/
*.pyc

# Local QA captures
/screenshots/
/public/screenshots/

# Root-level screenshot captures (Playwright / manual QA)
/screenshot-*.png
/compare.html

# Meshy AI — API responses and unapproved previews
/meshy_resp.json
/*_preview.png
/meshy_*.json

# Playwright test artifacts
/test-results/

# Claude Code — scheduled task lock and locally-installed skills
.claude/scheduled_tasks.lock
.claude/skills/

# Local secrets notes
.env.local.md

# Raw Higgsfield renders (originals; web versions live in public/)
assets-src/

# Local file storage (lib/storage.ts) and generated plan fixtures
/.storage/
/tmp/
