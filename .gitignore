# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# local databases
dev.db
*.db
*.sqlite
*.sqlite3

# log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
*.log

# env files
.env
.env.local
.env.*.local
# Keep .env.example tracked (must contain placeholders only)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/app/generated/prisma

# Claude Code — local settings and temporary worktrees
.claude/settings.local.json
.claude/worktrees/

# IDE / editor local files
.windsurf/
.vscode/settings.json
.idea/
